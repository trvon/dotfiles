/* Import color-scheme from `colors` directory.
 * current.rasi is GENERATED by ~/.config/sway/scripts/auto-theme.sh, which
 * copies gruvbox-light.rasi or gruvbox-dark.rasi over it, so the launcher
 * follows the desktop light/dark mode. */

@import "~/.config/rofi/colors/current.rasi"
