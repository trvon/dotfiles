# Swaylock-effects configuration.
#
# Colours are deliberately NOT set here: lock.sh passes them on the command
# line from the generated ~/.config/sway/theme.sh, so the lock screen follows
# the current light/dark theme and there is a single source of truth.
# This file holds the mode-independent parts only.

screenshots
clock
indicator
show-failed-attempts
show-keyboard-layout
effect-blur=7x5
effect-vignette=0.5:0.5
fade-in=0.2
grace=2

font=JetBrainsMono Nerd Font
timestr=%I:%M %p
datestr=%A, %B %d

indicator-radius=100
indicator-thickness=7
